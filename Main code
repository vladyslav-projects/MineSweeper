        temp = i + (97-26) ;
        printf("%c ", temp);
    }
    putchar('\n');
    for(int i = 0 ; i < N ; i++){
        char temp = i + 65 ;
        if(temp > 25+65)
        temp = i + (97-26) ;
        printf("%c   ", temp);
            for(int j = 0 ; j < N ; j++){
                value = calculate(board, i , j);
                if(boardcl[i][j]) printf("%d ", value);
                else printf("%s", "# ");
            }putchar('\n');
        }
}


