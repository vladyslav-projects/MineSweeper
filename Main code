#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define N 10 // MAX 52 !

int calculate(const int (*board)[N] , int x , int y)
{
    int sum = 0 ;
    int nx ; 
    int ny ; 
    for(int dx = -1 ; dx <= 1 ; dx++){
        for(int dy = -1 ; dy <= 1 ; dy++){
            nx = x - dx ;
            ny = y - dy ;

            if(nx >= 0 && nx < N && ny >= 0 && ny < N)
                sum += board[nx][ny];
        }
    }
    if(board[x][y] == 1) return -1 ;
    return sum ;
}

void open_zeros(int (*boardcl)[N], const int (*board)[N], int x , int y)
{
        if(calculate(board, x, y) != 0)
        return;
        for(int dx = -1 ; dx <= 1 ; dx++){
        for(int dy = -1 ; dy <= 1 ; dy++){
            int nx = x - dx ;
            int ny = y - dy ;

            if(nx >= 0 && nx < N && ny >= 0 && ny < N){
                int value = calculate(board, x, y) ;
                if(boardcl[nx][ny] == 0){
                    boardcl[nx][ny] = 1; 
                    if(value == 0)open_zeros(boardcl, board, nx , ny);
                }
                }
        }
    }
}

void print_cl(int (*boardcl)[N], const int (*board)[N])
{
    int value ;
    printf("    ");
